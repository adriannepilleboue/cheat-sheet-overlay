{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": ["shortcuts"],
    "properties": {
        "application": { "type": "string" },
        "shortcuts": {
            "type": "array",
            "items": {
                "type": "object",
                "required": ["name", "shortcut"],
                "properties": {
                    "name": { "type": "string" },
                    "shortcut": {
                        "type": "array",
                        "items": { "type": "string" },
                        "minItems": 1
                    }
                }
            }
        }
    }
}